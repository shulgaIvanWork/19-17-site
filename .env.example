# Отправка заявок из формы письмом (app/api/enquiry/route.ts).
# Для своей машины: скопируйте файл в .env.local (он не попадает в git) и заполните.
# На хостинге задайте те же переменные в настройках окружения приложения.

# Ящик Яндекс 360, от имени которого сайт отправляет письма.
SMTP_USER=

# Пароль приложения для этого ящика, не основной пароль аккаунта.
# id.yandex.ru -> Безопасность -> Пароли приложений -> Почта.
SMTP_PASS=

# Куда присылать заявки. Пусто - в тот же ящик SMTP_USER.
ENQUIRY_TO=

# Сервер и порт Яндекса по умолчанию, менять не нужно.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
